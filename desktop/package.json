{
  "name": "vera-desktop",
  "version": "1.0.0",
  "description": "Vera Browser for Windows",
  "main": "main.cjs",
  "author": "theDevstars",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.thedevstars.vera",
    "productName": "Vera Browser",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "index.html"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "artifactName": "Vera-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
